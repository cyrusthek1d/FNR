<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FOS Noten-Rechner Bayern</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1e40af;
      --success: #10b981;
      --success-light: #ecfdf5;
      --danger: #ef4444;
      --danger-light: #fef2f2;
      --warning: #f59e0b;
      --warning-light: #fffbeb;
      --neutral-50: #f9fafb;
      --neutral-100: #f3f4f6;
      --neutral-200: #e5e7eb;
      --neutral-300: #d1d5db;
      --neutral-400: #9ca3af;
      --neutral-500: #6b7280;
      --neutral-600: #4b5563;
      --neutral-700: #374151;
      --neutral-800: #1f2937;
      --neutral-900: #111827;
      
      --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
      
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      color: var(--neutral-900);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* ==================== SCREEN MANAGEMENT ==================== */
    .screen {
      display: none !important;
    }

    .screen.active {
      display: block !important;
      animation: fadeIn 0.5s ease-in;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ==================== SETUP SCREENS ==================== */
    .setup-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .setup-card {
      background: white;
      border-radius: 16px;
      padding: 40px;
      box-shadow: var(--shadow-xl);
      max-width: 600px;
      width: 100%;
      animation: slideUp 0.6s ease-out;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .setup-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .setup-header h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 10px;
      background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .setup-header p {
      color: var(--neutral-500);
      font-size: 15px;
    }

    .step-indicator {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
      gap: 10px;
    }

    .step {
      flex: 1;
      height: 4px;
      background: var(--neutral-200);
      border-radius: 2px;
      transition: var(--transition);
    }

    .step.active,
    .step.completed {
      background: var(--primary);
    }

    .form-group {
      margin-bottom: 25px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 10px;
      color: var(--neutral-700);
      font-size: 14px;
    }

    .form-group select,
    .form-group input {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid var(--neutral-200);
      border-radius: 8px;
      font-size: 15px;
      background: var(--neutral-50);
      color: var(--neutral-900);
      cursor: pointer;
      transition: var(--transition);
    }

    .form-group select:hover,
    .form-group input:hover {
      border-color: var(--primary);
      background: white;
    }

    .form-group select:focus,
    .form-group input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    /* ==================== CHECKBOX GRID ==================== */
    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .checkbox-item {
      display: flex;
      align-items: center;
      padding: 12px;
      border: 2px solid var(--neutral-200);
      border-radius: 8px;
      cursor: pointer;
      transition: var(--transition);
    }

    .checkbox-item:hover {
      border-color: var(--primary);
      background: var(--neutral-50);
    }

    .checkbox-item input[type="checkbox"] {
      margin-right: 10px;
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    .checkbox-item label {
      margin: 0 !important;
      cursor: pointer;
      flex: 1;
    }

    /* ==================== BUTTONS ==================== */
    .button-group {
      display: flex;
      gap: 10px;
      margin-top: 30px;
    }

    .btn {
      padding: 12px 24px;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: var(--transition);
      flex: 1;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
      color: white;
      box-shadow: var(--shadow-md);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-secondary {
      background: var(--neutral-200);
      color: var(--neutral-900);
    }

    .btn-secondary:hover {
      background: var(--neutral-300);
    }

    .btn-skip {
      background: none;
      border: 2px solid var(--neutral-300);
      color: var(--neutral-600);
    }

    .btn-skip:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* ==================== MAIN SCREEN ==================== */
    .main-screen {
      padding: 20px 0;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .header h1 {
      font-size: 28px;
      font-weight: 700;
      color: var(--neutral-900);
    }

    .header-info {
      display: flex;
      gap: 15px;
      align-items: center;
      flex-wrap: wrap;
    }

    .profile-tag {
      background: var(--primary);
      color: white;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
    }

    .btn-profile {
      background: var(--neutral-200);
      color: var(--neutral-900);
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 13px;
      transition: var(--transition);
    }

    .btn-profile:hover {
      background: var(--neutral-300);
    }

    /* ==================== CARDS ==================== */
    .card {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: var(--shadow-md);
      transition: var(--transition);
      margin-bottom: 20px;
    }

    .card:hover {
      box-shadow: var(--shadow-lg);
    }

    .card h2 {
      font-size: 18px;
      font-weight: 700;
      color: var(--neutral-900);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* ==================== ALERT CARDS ==================== */
    .alert-card {
      border-left: 4px solid;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .alert-warning {
      border-left-color: var(--warning);
      background: var(--warning-light);
      color: #92400e;
    }

    .alert-danger {
      border-left-color: var(--danger);
      background: var(--danger-light);
      color: #7f1d1d;
    }

    .alert-success {
      border-left-color: var(--success);
      background: var(--success-light);
      color: #065f46;
    }

    .alert-title {
      font-weight: 700;
      font-size: 16px;
      margin-bottom: 8px;
    }

    .alert-content {
      font-size: 14px;
      line-height: 1.6;
    }

    /* ==================== GRID ==================== */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    @media (max-width: 768px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    /* ==================== STAT CARD ==================== */
    .stat-card {
      background: linear-gradient(135deg, var(--primary) 0%, #7c3aed 100%);
      color: white;
      padding: 24px;
      border-radius: 12px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }

    .stat-value {
      font-size: 36px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .stat-label {
      font-size: 13px;
      opacity: 0.9;
      font-weight: 600;
    }

    /* ==================== SUBJECT CARD ==================== */
    .subject-card {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: var(--shadow-md);
      margin-bottom: 20px;
      border-left: 4px solid var(--primary);
    }

    .subject-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .subject-name {
      font-size: 18px;
      font-weight: 700;
      color: var(--neutral-900);
    }

    .subject-average {
      font-size: 24px;
      font-weight: 700;
      color: var(--primary);
    }

    .grade-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }

    .grade-chip {
      background: var(--neutral-100);
      border: 2px solid var(--neutral-200);
      border-radius: 6px;
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      animation: chipSlideIn 0.3s ease-out;
    }

    @keyframes chipSlideIn {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .grade-chip.excellent {
      background: var(--success-light);
      border-color: var(--success);
      color: #065f46;
    }

    .grade-chip.good {
      background: #f0f9ff;
      border-color: #0ea5e9;
      color: #0c4a6e;
    }

    .grade-chip.average {
      background: var(--warning-light);
      border-color: var(--warning);
      color: #92400e;
    }

    .grade-chip.poor {
      background: var(--danger-light);
      border-color: var(--danger);
      color: #7f1d1d;
    }

    .btn-delete {
      background: none;
      border: none;
      color: var(--neutral-400);
      cursor: pointer;
      font-weight: 700;
      transition: var(--transition);
      padding: 0 4px;
    }

    .btn-delete:hover {
      color: var(--danger);
    }

    /* ==================== INPUT CARD ==================== */
    .input-card {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: var(--shadow-md);
      margin-bottom: 30px;
    }

    .input-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 12px;
      margin-bottom: 16px;
    }

    @media (max-width: 768px) {
      .input-row {
        grid-template-columns: 1fr;
      }
    }

    .input-group {
      display: flex;
      flex-direction: column;
    }

    .input-group label {
      font-weight: 600;
      font-size: 12px;
      color: var(--neutral-600);
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .input-group select,
    .input-group input {
      padding: 10px 12px;
      border: 2px solid var(--neutral-200);
      border-radius: 6px;
      font-size: 14px;
      background: var(--neutral-50);
      color: var(--neutral-900);
      transition: var(--transition);
    }

    .input-group select:focus,
    .input-group input:focus {
      outline: none;
      border-color: var(--primary);
      background: white;
    }

    .btn-add {
      padding: 10px 16px;
      background: var(--success);
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: var(--transition);
      align-self: flex-end;
      margin-top: 22px;
    }

    .btn-add:hover {
      background: #059669;
      transform: translateY(-1px);
    }

    /* ==================== RESPONSIVE ==================== */
    @media (max-width: 768px) {
      .setup-card {
        padding: 30px 20px;
      }

      .setup-header h1 {
        font-size: 24px;
      }

      .header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- STEP 1: DIRECTION & CLASS -->
    <div id="setupStep1" class="screen active">
      <div class="setup-container">
        <div class="setup-card">
          <div class="setup-header">
            <h1>🎓 FOS Noten-Rechner</h1>
            <p>Schritt 1 von 3: Grundeinstellungen</p>
          </div>

          <div class="step-indicator">
            <div class="step active"></div>
            <div class="step"></div>
            <div class="step"></div>
          </div>

          <form id="step1Form">
            <div class="form-group">
              <label for="directionSelect">Ausbildungsrichtung</label>
              <select id="directionSelect" required>
                <option value="">-- Wähle deine Ausbildungsrichtung --</option>
                <option value="Technik">Technik</option>
                <option value="Wirtschaft und Verwaltung">Wirtschaft und Verwaltung</option>
                <option value="Internationale Wirtschaft">Internationale Wirtschaft</option>
                <option value="Sozialwesen">Sozialwesen</option>
                <option value="Gesundheit">Gesundheit</option>
                <option value="Gestaltung">Gestaltung</option>
                <option value="Agrarwirtschaft, Bio- und Umwelttechnologie">Agrarwirtschaft, Bio- & Umwelttechnologie</option>
              </select>
            </div>

            <div class="form-group">
              <label for="classSelect">Klasse</label>
              <select id="classSelect" required>
                <option value="">-- Wähle deine Klasse --</option>
                <option value="Vorklasse">Vorklasse</option>
                <option value="11">11. Klasse</option>
                <option value="12">12. Klasse</option>
                <option value="13">13. Klasse</option>
              </select>
            </div>

            <div class="button-group">
              <button type="submit" class="btn btn-primary">Weiter →</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- STEP 2: 11ER NOTEN (Nur für 12er) -->
    <div id="setupStep2" class="screen">
      <div class="setup-container">
        <div class="setup-card">
          <div class="setup-header">
            <h1>📋 11er Noten</h1>
            <p>Schritt 2 von 3: Möchtest du deine Noten aus der 11. Klasse eintragen?</p>
          </div>

          <div class="step-indicator">
            <div class="step completed"></div>
            <div class="step active"></div>
            <div class="step"></div>
          </div>

          <form id="step2Form">
            <div class="form-group">
              <label>11er Noten eintragen?</label>
              <select id="importNotes11" required>
                <option value="">-- Wähle eine Option --</option>
                <option value="yes">Ja, ich möchte meine 11er Noten eintragen</option>
                <option value="no">Nein, ich starte neu</option>
              </select>
            </div>

            <div class="button-group">
              <button type="button" class="btn btn-secondary" onclick="goBackStep2()">← Zurück</button>
              <button type="submit" class="btn btn-primary">Weiter →</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- STEP 3: WAHLPFLICHTFÄCHER -->
    <div id="setupStep3" class="screen">
      <div class="setup-container">
        <div class="setup-card">
          <div class="setup-header">
            <h1>📚 Wahlpflichtfächer</h1>
            <p>Schritt 3 von 3: Wähle deine Wahlpflichtfächer (optional)</p>
          </div>

          <div class="step-indicator">
            <div class="step completed"></div>
            <div class="step completed"></div>
            <div class="step active"></div>
          </div>

          <form id="step3Form">
            <div class="form-group">
              <label>Verfügbare Wahlpflichtfächer:</label>
              <div class="checkbox-grid" id="elektivesContainer"></div>
            </div>

            <div class="button-group">
              <button type="button" class="btn btn-secondary" onclick="goBackStep3()">← Zurück</button>
              <button type="submit" class="btn btn-primary">App starten →</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- MAIN SCREEN -->
    <div id="mainScreen" class="screen">
      <div class="main-screen">
        <div class="header">
          <h1>📊 Deine Noten</h1>
          <div class="header-info">
            <div class="profile-tag" id="profileTag">Technik · 11. Klasse</div>
            <button class="btn-profile" onclick="resetApp()">Neuer Start</button>
          </div>
        </div>

        <!-- PROBEZEIT INFO (Nur 11. Klasse) -->
        <div id="probezeitSection"></div>

        <!-- INPUT CARD -->
        <div class="input-card">
          <h2>➕ Neue Note hinzufügen</h2>
          <div class="input-row">
            <div class="input-group">
              <label for="subjectSelect">Fach</label>
              <select id="subjectSelect" required>
                <option value="">-- Wähle ein Fach --</option>
              </select>
            </div>
            <div class="input-group">
              <label for="typeSelect">Notenart</label>
              <select id="typeSelect" required>
                <option value="">-- Wähle Notenart --</option>
              </select>
            </div>
            <div class="input-group">
              <label for="gradeInput">Punkte (0-15)</label>
              <input type="number" id="gradeInput" min="0" max="15" placeholder="z.B. 7" required>
            </div>
          </div>
          <button type="button" class="btn-add" onclick="addGrade()">Note hinzufügen</button>
        </div>

        <!-- STATS -->
        <div class="grid" id="statsGrid"></div>

        <!-- SUBJECTS -->
        <div id="subjectsContainer"></div>
      </div>
    </div>
  </div>

