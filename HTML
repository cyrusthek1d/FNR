                <div style="font-size: 12px; margin-top: 4px;">Gesamtsumme</div>
              </div>
              ${requiredSum ? `<div style="background: rgba(255,255,255,0.5); padding: 12px; border-radius: 6px; text-align: center;">
                <div style="font-size: 20px; font-weight: 700;">+${requiredSum}</div>
