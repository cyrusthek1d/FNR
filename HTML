        html += `
          <div style="margin-bottom: 12px;">
            <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--neutral-600); margin-bottom: 8px;">${type}</div>
            <div class="grade-chips">
              ${grades.length === 0 ? '<div style="font-size: 13px; color: var(--neutral-500);">Noch keine Note</div>' : ""}
              ${grades.map((grade, idx) => {
                const color = getGradeColor(grade);
                return `
                  <div class="grade-chip ${color}">
                    ${grade}
                    <button class="btn-delete" onclick="deleteGrade('${subjectName}', '${type}', ${idx})">×</button>
                  </div>
                `;
              }).join("")}
            </div>
          </div>
        `;
      });

      return html;
    }

    function renderStats() {
      const globalAvg = calculateGlobalAverage();
      const subjects = getSubjectsForCurrentClass();
      const subjectsWithGrades = subjects.filter(s => calculateSubjectAverage(s.name) !== null).length;

      let html = `
        <div class="stat-card">
          <div class="stat-value">${globalAvg ? formatGrade(globalAvg) : "—"}</div>
          <div class="stat-label">Gesamtdurchschnitt</div>
        </div>
        <div class="stat-card" style="background: linear-gradient(135deg, var(--success) 0%, #06b6d4 100%);">
          <div class="stat-value">${subjectsWithGrades}</div>
          <div class="stat-label">Fächer mit Noten</div>
        </div>
      `;

      document.getElementById("statsGrid").innerHTML = html;
    }

    // ==================== STORAGE ====================
    function saveState() {
      localStorage.setItem("appState", JSON.stringify(appState));
    }

    function loadState() {
      const saved = localStorage.getItem("appState");
      if (saved) {
        appState = JSON.parse(saved);
      }
    }

    // ==================== START ====================
    window.addGrade = addGrade;
    window.deleteGrade = deleteGrade;
    window.resetApp = resetApp;
    window.goBackStep2 = goBackStep2;
    window.goBackStep3 = goBackStep3;

    init();
  </script>
</body>
</html>
