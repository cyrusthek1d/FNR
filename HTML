      const probezeit = calculateProbezeit();
      if (!probezeit) {
        container.innerHTML = "";
        return;
      }

      const totalSum = probezeit.totalSum.toFixed(2);
      const underCount = probezeit.underperforming.length;
      const requiredSum = probezeit.requiredSum ? probezeit.requiredSum.toFixed(2) : null;

      let statusText = "";
      let statusClass = "";

      if (probezeit.status === "bestanden" && underCount === 0 && probezeit.subjectAverages.every(s => s.avg >= 4.0)) {
        statusText = "✅ Probezeit bestanden! Alle Fächer ≥ 4.0";
        statusClass = "alert-success";
      } else if (probezeit.status === "bestanden") {
        statusText = "✅ Probezeit bestanden!";
        statusClass = "alert-success";
      } else if (underCount === 1) {
        statusText = `⚠️ Eine Unterpunktung (≤3.0): Du brauchst Gesamtsumme ≥37`;
        statusClass = "alert-warning";
      } else if (underCount >= 2) {
        statusText = `🚨 ${underCount} Unterpunktungen (≤3.0): Du brauchst Gesamtsumme ≥42`;
        statusClass = "alert-danger";
      }

      container.innerHTML = `
