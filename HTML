      saveState();
      gradeInput.value = "";
      document.getElementById("subjectSelect").value = "";
      document.getElementById("typeSelect").innerHTML = '<option value="">-- Wähle Notenart --</option>';
      renderAll();
    }

    function deleteGrade(subject, type, index) {
      const key = `${subject}|${type}`;
      if (appState.grades[key]) {
        appState.grades[key].splice(index, 1);
        if (appState.grades[key].length === 0) {
          delete appState.grades[key];
        }
        saveState();
        renderAll();
      }
    }

    // ==================== CALCULATIONS ====================
    function calculateSubjectAverage(subject) {
      const subjects = getSubjectsForCurrentClass();
      const subjectConfig = subjects.find(s => s.name === subject);
      
      if (!subjectConfig) return null;

      const weightedGrades = [];

      subjectConfig.types.forEach(type => {
        const key = `${subject}|${type}`;
        const grades = appState.grades[key] || [];
        
        let weight = 1;
        if (type === "Kurzarbeit") weight = 2;
        if (type === "Schulaufgabe") weight = 3;

        grades.forEach(grade => {
          for (let i = 0; i < weight; i++) {
            weightedGrades.push(grade);
          }
        });
      });

      if (weightedGrades.length === 0) return null;

      const sum = weightedGrades.reduce((a, b) => a + b, 0);
      return sum / weightedGrades.length;
    }

    function calculateGlobalAverage() {
      const subjects = getSubjectsForCurrentClass();
      const averages = [];

      subjects.forEach(subject => {
        const avg = calculateSubjectAverage(subject.name);
        if (avg !== null) {
          averages.push(avg);
        }
      });

      if (averages.length === 0) return null;
      const sum = averages.reduce((a, b) => a + b, 0);
      return sum / averages.length;
    }

    function formatGrade(grade) {
      if (grade >= 13.33) return "1";
      if (grade >= 10.67) return "2";
      if (grade >= 8) return "3";
      if (grade >= 5.33) return "4";
      if (grade >= 2.67) return "5";
      return "6";
    }

    function getGradeColor(grade) {
      if (grade >= 13.33) return "excellent";
      if (grade >= 10.67) return "good";
      if (grade >= 8) return "average";
      return "poor";
    }

    // ==================== PROBEZEIT BERECHNUNG (11. Klasse) ====================
    function calculateProbezeit() {
      if (appState.class !== "11") return null;

      const subjects = getSubjectsForCurrentClass();
      const subjectAverages = subjects.map(s => ({
        name: s.name,
        avg: calculateSubjectAverage(s.name)
      })).filter(s => s.avg !== null);

      if (subjectAverages.length === 0) return null;

      // Zähle Unterpunktungen (≤3.0)
      const underperforming = subjectAverages.filter(s => s.avg <= 3.0);
      const totalSum = subjectAverages.reduce((sum, s) => sum + s.avg, 0);

      let status = "bestanden";
      let requiredSum = null;

      if (underperforming.length === 0 && subjectAverages.every(s => s.avg >= 4.0)) {
        status = "bestanden"; // Alle ≥4
      } else if (underperforming.length === 1 && totalSum < 37) {
        status = "gefährdet";
        requiredSum = 37 - totalSum;
      } else if (underperforming.length >= 2 && totalSum < 42) {
        status = "gefährdet";
        requiredSum = 42 - totalSum;
      }

      return {
        underperforming,
        totalSum,
        requiredSum,
        status,
        subjectAverages,
        hasProbezeit: true
      };
    }

