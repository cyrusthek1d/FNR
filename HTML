      const grade = parseInt(gradeInput.value);

      if (!subject || !type || isNaN(grade) || grade < 0 || grade > 15) {
        alert("Bitte alle Felder korrekt ausfüllen (0-15 Punkte)");
        return;
      }

      const key = `${subject}|${type}`;
      if (!appState.grades[key]) {
